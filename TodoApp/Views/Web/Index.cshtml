<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Bootstrap demo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body>
    <div class="container border p-5 mt-5">
        <h4 class="text-capitalize">@Model.Title</h4>
        <p>@Model.News</p>
        <label class="text-uppercase">@Model.Date</label>

        
        <section>
            <label class="text-primary">primary</label>
            <label class="text-secondary">secondary</label>
            <label class="text-success">success</label>
            <label class="text-warning">warning</label>
            <label class="text-danger">danger</label>
        </section>
        
        <section>
            <label class="bg-primary p-4"></label>
            <label class="bg-secondary p-4"></label>
            <label class="bg-success p-4"></label>
            <label class="bg-warning p-4"></label>
            <label class="bg-danger p-4"></label>
        </section>

        <section>
            <label class="bg-primary text-white p-4">primary</label>
        </section>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>